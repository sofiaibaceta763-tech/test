<body>
    
<head>Formulario de contacto</head>
<div id="contenedor">

<form action="#" method="POST">
  <div>
    <label for="nombre">Nombre:</label>
    <input type="text" id="nombre" name="nombre" required>
  </div>

  <div>
    <label for="apellido">Apellido:</label>
    <input type="text" id="apellido" name="apellido" required>
  </div>

  <div>
    <label for="mail">Correo electrónico:</label>
    <input type="email" id="mail" name="mail" required>
  </div>

  <div>
    <label for="asunto">Asunto:</label>
    <input type="text" id="asunto" name="asunto" required>
  </div>

  <div>
    <label for="mensaje">Mensaje:</label>
    <textarea id="mensaje" name="mensaje" rows="4"></textarea>
  </div>
    <!-- 1. SCRIPT CORRECTO PARA RECAPTCHA V2 -->
    <script src="https://google.com" async defer></script>


  <!-- 2. TU CASILLA DE RECAPTCHA (Ya tiene tu clave del sitio configurada) -->
  <div>
    <div class="g-recaptcha" data-sitekey="6LezSvktAAAAAIVMX4hEo4jAEm7zFUMmK32r-A4y"></div>
  </div>
  
  <br>
  <button type="submit">Enviar</button>
</form>
</body>
</html>
